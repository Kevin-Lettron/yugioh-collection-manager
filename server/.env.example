# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yugioh_collection
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
# IMPORTANT: generate a random 64-char secret in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start if this is empty, too short, or a default value.
JWT_SECRET=CHANGE_ME_generate_a_64_char_random_hex_string
JWT_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# API
YGOPRODECK_API_URL=https://db.ygoprodeck.com/api/v7

# Claude API (AI deck builder + card scan via Vision)
CLAUDE_API_KEY=sk-ant-...
# Quota AI deck builder (par redémarrage serveur)
CLAUDE_API_MAX_CALLS=5
# Quota scan photo (par redémarrage serveur)
CLAUDE_SCAN_MAX_CALLS=30
